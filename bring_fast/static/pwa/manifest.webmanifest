{
  "id": "/",
  "name": "Bring Fast",
  "short_name": "Bring Fast",
  "description": "Grocery spend, receipts and live supermarket prices.",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "any",
  "background_color": "#05060c",
  "theme_color": "#05060c",
  "lang": "en",
  "dir": "ltr",
  "categories": ["shopping", "finance", "utilities"],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": { "client_mode": "navigate-existing" },
  "icons": [
    {
      "src": "/static/pwa/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/static/pwa/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
